@model System.Data.DataTable
@using System.Data
@{
    ViewData["Title"] = "Manage Customer Bookings - Autonexa Admin";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-success"><i class="bi bi-list-check"></i> Customer Service Bookings</h3>
        <a asp-action="AdminDashboard" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    @if (TempData["msg"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
            @TempData["msg"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model != null && Model.Rows.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Customer</th>
                                <th>Vehicle</th>
                                <th>Service</th>
                                <th>Mode</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (DataRow row in Model.Rows)
                            {
                                <tr>
                                    <td>#@row[0]</td>
                                    <td>@row[1]</td>
                                    <td>@row[2]</td>
                                    <td>@row[3]</td>
                                    <td>@row[4]</td>
                                    <td>
                                        @if (row[5].ToString() == "Completed")
                                        {
                                            <span class="badge bg-success">Completed</span>
                                        }
                                        else if (row[5].ToString() == "Cancelled")
                                        {
                                            <span class="badge bg-danger">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@row[5]</span>
                                        }
                                    </td>
                                    <td>@Convert.ToDateTime(row[6]).ToString("dd-MMM-yyyy")</td>
                                    <td class="text-end">
                                        @if (row[5].ToString() != "Completed" && row[5].ToString() != "Cancelled")
                                        {
                                            <a asp-action="UpdateStatus" asp-route-bId="@row[0]" asp-route-status="Completed" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-check-circle"></i> Mark Completed
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <p class="fs-5">No bookings found in the system.</p>
                </div>
            }
        </div>
    </div>
</div>