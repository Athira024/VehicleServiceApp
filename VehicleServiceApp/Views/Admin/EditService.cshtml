@model VehicleServiceApp.Models.ServiceCls 
@{
    ViewData["Title"] = "Edit Service - Autonexa Admin";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="fw-bold text-success mb-4"><i class="bi bi-pencil-square"></i> Edit Service Details</h3>

                    @if (TempData["msg"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["msg"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="EditService" method="post">
                        <input type="hidden" asp-for="Service_Id" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Service Name</label>
                            <input asp-for="Service_Name" class="form-control" required />
                            <span asp-validation-for="Service_Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Service_Desc" class="form-control" rows="3" required></textarea>
                            <span asp-validation-for="Service_Desc" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Price (₹)</label>
                            <input asp-for="Service_Price" type="number" step="0.01" class="form-control" required />
                            <span asp-validation-for="Service_Price" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="ViewServices" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>