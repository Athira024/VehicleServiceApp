@model System.Data.DataTable
@using System.Data
@{
    ViewData["Title"] = "Manage Services - Autonexa Admin";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-success"><i class="bi bi-gear-fill"></i> Manage Services</h3>
        <a asp-action="AddService" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New Service
        </a>
    </div>

    @if (TempData["msg"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["msg"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model != null && Model.Rows.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                @* <th>ID</th> *@
                                <th>Service Name</th>
                                <th>Description</th>
                                <th>Price</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (DataRow row in Model.Rows)
                            {
                                <tr>
                                    <td>@row["Service_Name"]</td>
                                    <td>@row["Service_Desc"]</td>
                                    <td>₹@row["Service_Price"]</td>

                                    <!-- Edit Link Button -->
                                    <td class="text-end">
                                        <a asp-action="EditService" asp-route-id="@row["Service_Id"]" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <p class="fs-5">No services found in the system.</p>
                </div>
            }
        </div>
    </div>
</div>